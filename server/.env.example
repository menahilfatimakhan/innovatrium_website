# Copy this file to ".env" in the same folder and fill in real values.
# NEVER commit the real .env — it is gitignored.

# Password the admin types to sign in to /admin.html
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on (Nginx proxies to this).
PORT=3000

# Set to "production" on the live server so the session cookie is HTTPS-only.
NODE_ENV=production
