# Copy this file to ".env" in the same folder and fill in real values.
# NEVER commit the real .env — it is gitignored.

# Port the server listens on (Nginx proxies to this).
PORT=3000

# Set to "production" on the live server.
NODE_ENV=production

# Strapi CMS
# Base URL of the self-hosted Strapi instance (its own process/port).
STRAPI_URL=http://localhost:1337
# Full-access API token, created in Strapi under Settings > API Tokens.
STRAPI_API_TOKEN=change-this-to-a-strapi-api-token
# Shared secret Strapi's webhook must send in a header (e.g. X-Webhook-Secret)
# so /api/webhooks/strapi-publish can verify the request came from Strapi.
STRAPI_WEBHOOK_SECRET=change-this-to-a-long-random-string
